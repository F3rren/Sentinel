# Copy to .env.prod, then: docker compose -f docker/docker-compose.prod.yml --env-file .env.prod up -d --build
# (run from the repo root; docker compose only auto-loads a file literally named .env -
# see docker/docker-compose.prod.yml)

# ── Victim's Docker network ──────────────────────────────────────────────────────────
# See env.example for how to find this.
VICTIM_NETWORK_NAME=

# ── Host port ─────────────────────────────────────────────────────────────────────────
SENTINEL_PORT=8088

# ── Scan tuning (optional) ───────────────────────────────────────────────────────────
SENTINEL_SCAN_MAX_ENDPOINTS=25
SENTINEL_SCAN_AUTO_TARGET_URL=

# ── Attack modules (optional) ────────────────────────────────────────────────────────
SENTINEL_SCAN_SQL_INJECTION_ENABLED=true
SENTINEL_SCAN_MISSING_AUTHENTICATION_ENABLED=true
SENTINEL_SCAN_BRUTE_FORCE_ENABLED=true
SENTINEL_SCAN_SECURITY_MISCONFIGURATION_ENABLED=true
SENTINEL_SCAN_XSS_ENABLED=true
SENTINEL_SCAN_RATE_LIMIT_ENABLED=true
SENTINEL_SCAN_RATE_LIMIT_BURST_SIZE=130

# IDOR is opt-in and defaults to false unlike every other module above: it's meaningless
# without two identities to compare, supplied per-scan via POST /api/scans' "identities"
# field, not via this file. Set to true here only to make the module instantiate at all.
SENTINEL_SCAN_IDOR_ENABLED=false

# BFLA (Broken Function Level Authorization) is opt-in for the same reason: it's meaningless
# without at least one real identity to test with. Flags endpoints whose path suggests a
# privileged/administrative function (e.g. contains "admin") but that a regular authenticated
# identity can still reach.
SENTINEL_SCAN_BFLA_ENABLED=false

# ── HTTP methods to attack (optional) ────────────────────────────────────────────────
# Every method allowed by default in prod, matching a real engagement's actual scope.
# Restrict to GET if this particular engagement is read-only.
SENTINEL_SCAN_ALLOWED_HTTP_METHODS=GET,POST,PUT,PATCH,DELETE

# ── HTTP request/response logging (optional) ────────────────────────────────────────
# INFO by default in prod - DEBUG logs every single request and gets noisy fast at scale.
SENTINEL_LOG_HTTP_LEVEL=INFO
