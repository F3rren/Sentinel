# Copy to .env.test - optional, only needed to tune the JVM running the test suite.
# docker compose -f docker-compose.test.yml --env-file .env.test up --build --abort-on-container-exit
#
# The test environment doesn't talk to a victim, so there's no VICTIM_NETWORK_NAME or
# scan-tuning variables here - unlike env.dev.example / env.prod.example.

# Useful on a memory-constrained CI runner, e.g. MAVEN_OPTS=-Xmx1g
MAVEN_OPTS=
