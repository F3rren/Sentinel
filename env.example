# Copy this file to .env (docker compose loads it automatically, no need to export
# anything in your shell) before pointing Sentinel at a victim. Re-edit it whenever you
# switch to a different victim project.

# ── Victim's Docker network ──────────────────────────────────────────────────────────
# The Docker network name the victim's own docker-compose created, so Sentinel can join
# it and reach the victim by container name (e.g. http://api-gateway:8080) instead of
# localhost. Find the real name with:
#
#   docker network ls
#
# Compose usually prefixes the network with the victim project's folder name, e.g. a
# network named "backend-network" declared inside a project cloned into "some-victim-app"
# becomes "some-victim-app_backend-network" - unless that project's compose file sets an
# explicit top-level `name:` on the network, in which case use that name verbatim.
# Defaults to aquarium-ms's own network name, so against that victim specifically this can
# be left empty. Example, for a different victim: VICTIM_NETWORK_NAME=some-victim-app_backend-network
VICTIM_NETWORK_NAME=

# ── Scan tuning (optional) ───────────────────────────────────────────────────────────
# Raise this for victims with a large API surface (e.g. several microservices behind a
# gateway) so a full pass isn't truncated. Leave unset to use the app's own default (25).
SENTINEL_SCAN_MAX_ENDPOINTS=25

# ── Fully automatic scan on startup (optional) ───────────────────────────────────────
# If set, Sentinel scans this URL by itself as soon as it starts and the target becomes
# reachable - no manual POST /api/scans needed. Fetch the outcome any time from
# GET /api/scans/latest. Leave empty to keep triggering scans manually via the API.
# Example, for the aquarium-ms victim: SENTINEL_SCAN_AUTO_TARGET_URL=http://api-gateway:8080
SENTINEL_SCAN_AUTO_TARGET_URL=

# ── Attack modules (optional) ────────────────────────────────────────────────────────
# One on/off switch per module, all default to true. Set to false to skip a module
# entirely for every scan (e.g. it's noisy, out of scope, or you only want a subset).
SENTINEL_SCAN_SQL_INJECTION_ENABLED=true
SENTINEL_SCAN_MISSING_AUTHENTICATION_ENABLED=true
SENTINEL_SCAN_BRUTE_FORCE_ENABLED=true
SENTINEL_SCAN_SECURITY_MISCONFIGURATION_ENABLED=true
SENTINEL_SCAN_XSS_ENABLED=true
SENTINEL_SCAN_RATE_LIMIT_ENABLED=true

# IDOR is opt-in and defaults to false unlike every other module above: it's meaningless
# without two identities to compare, supplied per-scan via POST /api/scans' "identities"
# field, not via this file. Set to true here only to make the module instantiate at all.
SENTINEL_SCAN_IDOR_ENABLED=false

# BFLA (Broken Function Level Authorization) is opt-in for the same reason: it's meaningless
# without at least one real identity to test with. Flags endpoints whose path suggests a
# privileged/administrative function (e.g. contains "admin") but that a regular authenticated
# identity can still reach.
SENTINEL_SCAN_BFLA_ENABLED=false

# The rate-limit module's burst must exceed the victim's real rate-limit capacity to be a
# meaningful test - a smaller burst will never trip it, and MISSING_RATE_LIMITING findings on a
# victim that does throttle (just at a higher threshold) become less informative. Raise this if
# you know (or suspect) the victim allows more than the default before throttling; lower it for
# a faster scan if you don't care about precision here.
SENTINEL_SCAN_RATE_LIMIT_BURST_SIZE=130

# ── HTTP methods to attack (optional) ────────────────────────────────────────────────
# Discovery always finds endpoints of every method, but only the ones listed here get
# attacked. GET-only by default, so re-running the same scan against the same local victim
# repeatedly while iterating never mutates its data. Widen this once you deliberately want
# to exercise write endpoints too.
# Example, every method: SENTINEL_SCAN_ALLOWED_HTTP_METHODS=GET,POST,PUT,PATCH,DELETE
SENTINEL_SCAN_ALLOWED_HTTP_METHODS=GET

# ── HTTP request/response logging (optional) ────────────────────────────────────────
# DEBUG by default, for full visibility while iterating against a local victim: logs every
# request an attack module makes (method, URL, status code, elapsed time). Set to INFO once
# that gets noisy (e.g. a long-running scan against a large API).
SENTINEL_LOG_HTTP_LEVEL=DEBUG
