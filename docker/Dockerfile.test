# Test image: its only job is running the Maven test suite. Building it (`docker compose -f
# docker-compose.test.yml build`) fails with a non-zero exit code the moment any test fails,
# which is all a CI pipeline step needs; running it (`up`) does the same and then exits. Gives
# a clean, reproducible test run - same JDK/Maven every time, on any machine - without requiring
# either installed locally.
FROM maven:3.9-eclipse-temurin-17
WORKDIR /app
COPY pom.xml .
RUN mvn -q -B dependency:go-offline
COPY src src
CMD ["mvn", "-B", "test"]
