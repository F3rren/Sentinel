# Production image: multi-stage build so the final image ships only a JRE and the packaged
# jar - no Maven, no build cache, no source - which keeps it small and reduces the attack
# surface of the image itself. Runs as a dedicated non-root user, since the process needs no
# privilege beyond binding to its own port.
FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /build
COPY pom.xml .
RUN mvn -q -B dependency:go-offline
COPY src src
RUN mvn -q -B package -DskipTests

FROM eclipse-temurin:17-jre-jammy
RUN useradd --system --no-create-home --shell /usr/sbin/nologin sentinel
WORKDIR /app
COPY --from=build /build/target/sentinel-*.jar app.jar
RUN chown sentinel:sentinel app.jar
USER sentinel
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=3s --start-period=20s --retries=5 \
    CMD bash -c 'cat < /dev/null > /dev/tcp/127.0.0.1/8080' || exit 1
ENTRYPOINT ["java", "-jar", "app.jar"]
